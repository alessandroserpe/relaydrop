    "/v1/transfers/{id}/envelopes": {
      "post": {
        "operationId": "shareDeviceKeys",
        "description": "Sender/recipient identity plus download capability. Add encrypted key envelopes for missing browsers of that same identity only. No count/expiry changes; expired/exhausted/revoked files unavailable. Idempotent; existing envelopes cannot be overwritten.",
        "security": [
          {
            "IdentityToken": []
          },
          {
            "Session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
